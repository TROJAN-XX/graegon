# ============================================================
# graegon .gitignore
# Rule of thumb: never commit dependencies, build output,
# local secrets, editor/OS junk, or Firebase CLI logs.
# ============================================================

# ---------- dependencies ----------
/node_modules
/.pnp
.pnp.js

# ---------- production build ----------
# `build/` is produced by `npm run build` and published by CI
# (.github/workflows/deploy.yaml). It must never be committed.
/build
/out

# ---------- testing ----------
/coverage

# ---------- environment / secrets ----------
# Firebase *web* config is safe to ship, but keep .env files local.
# Use `REACT_APP_*` variables (see development.md -> Environment configuration).
.env
.env.*
!.env.example

# ---------- firebase CLI ----------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log

# ---------- logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- editors & OS ----------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# ---------- misc tooling ----------
.eslintcache
.cache/
*.tsbuildinfo
