# graegon environment template
#
# Copy to `.env` (gitignored) and fill in real values when the app reads its
# Firebase config from the environment (pendingworks.md -> P1-8).
# Until then the same values live in `src/firebase.js`.
#
# CRA only exposes variables prefixed with REACT_APP_ - restart `npm start`
# after changing this file.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=graegonx.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=graegonx
REACT_APP_FIREBASE_STORAGE_BUCKET=graegonx.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
